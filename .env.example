# Copie para .env.local se quiser alterar algo. Sem este arquivo, o ambiente local funciona com os padrões abaixo.
# Nunca coloque segredos reais em arquivos versionados.
APP_ENV=development
APP_NAME=Plataforma de Serviços

# Banco: PostgreSQL embarcado (PGlite). Padrão: ~/.plataforma-servicos/pgdata (fora do projeto, para o
# next dev não recarregar a página a cada gravação). "memory" = em memória (usado nos testes).
# PGLITE_DIR=

# Segredos locais. Em produção são obrigatórios e a aplicação recusa os valores padrão.
AUTH_SECRET=replace_with_local_random_secret
PAYMENT_WEBHOOK_SECRET=

# Adaptadores. Só existe "mock" hoje; produção recusa iniciar com mock (pendências O02 e O08).
PAYMENT_PROVIDER=mock
IDENTITY_PROVIDER=mock

# Comissão comercial ainda indefinida (O01). Vazio = 0 sintético em dev/teste; produção exige valor explícito.
PLATFORM_FEE_BPS=
POLICY_STATUS=draft

# Flags operacionais por categoria. Desligadas, a API recusa a contratação mesmo contornando a interface.
FEATURE_TRANSPORT=false
FEATURE_SECURITY_SERVICES=false
FEATURE_DELIVERY=false

# Minutos que o trabalhador permanece "aberto a trabalho" antes de expirar sozinho.
ONLINE_WINDOW_MINUTES=60
